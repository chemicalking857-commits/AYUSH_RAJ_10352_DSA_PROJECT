%PreformattedPara
0 0 0 rg
BT 1 0 0 1 0 508.9 Tm /F3 7.1 Tf 8.6 TL (001  import java.util.*;) Tj T* (002  ) Tj T* (003  public class AmbulanceDispatchSimulator {) Tj T* (004  ) Tj T* (005      // ---------- Edge: one road to a neighbour location ----------) Tj T* (006      static class Edge {) Tj T* (007          String to;   // neighbour location) Tj T* (008          int km;      // distance in km) Tj T* (009  ) Tj T* (010          Edge\(String to, int km\) {) Tj T* (011              this.to = to;) Tj T* (012              this.km = km;) Tj T* (013          }) Tj T* (014      }) Tj T* (015  ) Tj T* (016      // ---------- Node: item stored in Dijkstra's PriorityQueue ----------) Tj T* (017      // The node with the smallest distance comes out first.) Tj T* (018      static class Node implements Comparable<Node> {) Tj T* (019          String name;) Tj T* (020          int dist;) Tj T* (021  ) Tj T* (022          Node\(String name, int dist\) {) Tj T* (023              this.name = name;) Tj T* (024              this.dist = dist;) Tj T* (025          }) Tj T* (026  ) Tj T* (027          public int compareTo\(Node other\) {) Tj T* (028              return this.dist - other.dist;) Tj T* (029          }) Tj T* (030      }) Tj T* (031  ) Tj T* (032      // ---------- Graph: the city map \(adjacency list\) ----------) Tj T* (033      static class Graph {) Tj T* (034          HashMap<String, ArrayList<Edge>> adj = new HashMap<>\(\);) Tj T* (035          HashMap<String, Integer> dist = new HashMap<>\(\);   // shortest distance found) Tj T* (036          HashMap<String, String> parent = new HashMap<>\(\);  // previous location on the path) Tj T* (037  ) Tj T* (038          // A road works in both directions, so add it twice.) Tj T* (039          void addRoad\(String a, String b, int km\) {) Tj T* (040              if \(!adj.containsKey\(a\)\) adj.put\(a, new ArrayList<Edge>\(\)\);) Tj T* (041              if \(!adj.containsKey\(b\)\) adj.put\(b, new ArrayList<Edge>\(\)\);) Tj T* (042              adj.get\(a\).add\(new Edge\(b, km\)\);) Tj T* (043              adj.get\(b\).add\(new Edge\(a, km\)\);) Tj T* (044          }) Tj T* (045  ) Tj T* (046          boolean hasLocation\(String name\) {) Tj T* (047              return adj.containsKey\(name\);) Tj T* (048          }) Tj T* (049  ) Tj T* (050          // Dijkstra's algorithm: finds the shortest distance from src to every location.) Tj T* (051          void dijkstra\(String src\) {) Tj T* (052              dist.clear\(\);) Tj T* (053              parent.clear\(\);) Tj T* (054              for \(String loc : adj.keySet\(\)\) {) Tj T* (055                  dist.put\(loc, 999999\);          // 999999 means "not reached yet") Tj T* (056              }) Tj T* (057              dist.put\(src, 0\);) Tj T* (058  ) Tj T* (059              PriorityQueue<Node> pq = new PriorityQueue<>\(\);) Tj T* (060              pq.add\(new Node\(src, 0\)\);) Tj T* ET
Q
