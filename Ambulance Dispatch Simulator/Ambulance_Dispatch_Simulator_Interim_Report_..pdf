1 0 0 1 66 61.68976 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 0 130.5 Tm /F3 7.1 Tf 8.6 TL (061  ) Tj T* (062              while \(!pq.isEmpty\(\)\) {) Tj T* (063                  Node current = pq.poll\(\);       // closest location not yet processed) Tj T* (064                  if \(current.dist > dist.get\(current.name\)\) {) Tj T* (065                      continue;                   // old entry, a shorter way was already found) Tj T* (066                  }) Tj T* (067                  for \(Edge e : adj.get\(current.name\)\) {) Tj T* (068                      int newDist = current.dist + e.km;) Tj T* (069                      if \(newDist < dist.get\(e.to\)\) {      // shorter way found) Tj T* (070                          dist.put\(e.to, newDist\);) Tj T* (071                          parent.put\(e.to, current.name\);) Tj T* (072                          pq.add\(new Node\(e.to, newDist\)\);) Tj T* (073                      }) Tj T* (074                  }) Tj T* (075              }) Tj T* (076          }) Tj T* ET
